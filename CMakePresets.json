{
    "version": 4,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Weighted Matching",
            "description": "The default preset to use with this project",
            "binaryDir": "${sourceDir}/build/default",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "log",
            "displayName": "Weighted Matching with Logs",
            "description": "Logs the steps of the algorithms.",
            "binaryDir": "${sourceDir}/build/logged",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_BUILD_TYPE": "Debug",
                "LOG": "TRUE"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "configuration": "Release"
        },
        { "name": "log", "configurePreset": "log" }
    ]
}
